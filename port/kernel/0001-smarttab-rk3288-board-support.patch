+static const struct jadard_panel_desc smarttab_rk3288_desc = {
+	.mode_4ln = &(const struct drm_display_mode) {
+		/*
+		 * Vendor: 68 MHz. On mainline RK3288 dclk_vop0 can only reach
+		 * cpll 400 MHz / 6 = 66.667 MHz (NPLL does not lock under the vendor
+		 * Trust OS). dw-mipi-dsi computes its line timing from this nominal
+		 * clock, so it must match the real dclk or DPI and DSI drift apart
+		 * (text jitters). 66667 kHz -> 58.6 Hz refresh.
+		 */
+		.clock		= 66667,
+
+		/*
+		 * Vendor porches are hfp 20 / hbp 20, but with them the panel shows
+		 * the image 4 px late (x 0..3 lost, wrapped to the far edge). Pattern
+		 * test 2026-11-08: hfp 24 / hbp 16 shows all 800 columns. Vertical:
+		 * the last 4 lines are hidden with vendor 30/4/8; making them visible
+		 * (vbp 12+) exposes a moving glitch there, so vertical stays stock.
+		 */
+		.hdisplay	= 800,
+		.hsync_start	= 800 + 24,
+		.hsync_end	= 800 + 24 + 20,
+		.htotal		= 800 + 24 + 20 + 16,
+
+		.vdisplay	= 1280,
+		.vsync_start	= 1280 + 30,
+		.vsync_end	= 1280 + 30 + 4,
+		.vtotal		= 1280 + 30 + 4 + 8,
+
+		.width_mm	= 135,
+		.height_mm	= 216,
+		/*
+		 * Vendor timing: hsync-active = vsync-active = 0 (active low).
+		 * Without these flags the rk3288 VOP drives active-low syncs while
+		 * dw-mipi-dsi is set active-high -> panel decodes lines out of step:
+		 * colours scrambled (red->cyan, green->magenta), alternating-line
+		 * pattern. Found 2026-11-08 by stock-U-Boot vs Linux register diff.
+		 */
+		.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+		.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	},
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init = smarttab_rk3288_init_cmds,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_LPM,
+};
