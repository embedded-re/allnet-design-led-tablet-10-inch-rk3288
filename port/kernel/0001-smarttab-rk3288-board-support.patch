diff --git a/arch/arm/boot/dts/rockchip/rk3288-smarttab.dts b/arch/arm/boot/dts/rockchip/rk3288-smarttab.dts
new file mode 100644
index 000000000..e37eef54a
--- /dev/null
+++ b/arch/arm/boot/dts/rockchip/rk3288-smarttab.dts
@@ -0,0 +1,838 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RK3288 "SmartTab" 10.1" tablet (Android 8.1 vendor image, 2 GB DDR3, 16 GB eMMC).
+ *
+ * Every board-specific value here comes from the vendor Android device tree
+ * (see hardware/vendor/android_boot.dts in the RE project). Structure follows
+ * rk3288-firefly.dtsi, whose reference design this board shares
+ * (ACT8846 + SYR827/828 + HYM8563 + RTL8211E).
+ */
+
+/dts-v1/;
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "rk3288.dtsi"
+
+/ {
+	model = "SmartTab RK3288 tablet";
+	compatible = "smarttab,rk3288-tablet", "rockchip,rk3288";
+
+	/* vendor: es8316 spk-con-gpio = GPIO7_B0, active high */
+	speaker_amp: audio-amplifier {
+		compatible = "simple-audio-amplifier";
+		enable-gpios = <&gpio7 RK_PB0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&spk_en>;
+		sound-name-prefix = "Speaker Amp";
+	};
+
+	/* vendor: simple-audio-card "rockchip,es8316-codec", i2s, mclk-fs 512 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "SmartTab ES8316";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <512>;
+		simple-audio-card,aux-devs = <&speaker_amp>;
+		simple-audio-card,widgets =
+			"Microphone", "Microphone Jack",
+			"Headphone", "Headphone Jack",
+			"Speaker", "Speaker";
+		simple-audio-card,routing =
+			"MIC1", "Microphone Jack",
+			"MIC2", "Microphone Jack",
+			"Headphone Jack", "HPOL",
+			"Headphone Jack", "HPOR",
+			"Speaker Amp INL", "HPOL",
+			"Speaker Amp INR", "HPOR",
+			"Speaker", "Speaker Amp OUTL",
+			"Speaker", "Speaker Amp OUTR";
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&es8316>;
+		};
+	};
+
+	aliases {
+		ethernet0 = &gmac;
+		mmc0 = &emmc;
+		mmc1 = &sdmmc;
+		mmc2 = &sdio0;
+	};
+
+	chosen {
+		stdout-path = "serial2:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>;
+	};
+
+	/*
+	 * The vendor Trust OS (OP-TEE, loaded at 0x08400000 by the miniloader) stays
+	 * resident; stock U-Boot passes this hole as a gap between its two memory banks.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		trust_os@8400000 {
+			reg = <0x0 0x08400000 0x0 0x00e00000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * Linux runs in the non-secure world here: the vendor miniloader starts a
+	 * resident Trust OS (OP-TEE) that owns the secure peripherals and offers PSCI.
+	 */
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	adc-keys {
+		compatible = "adc-keys";
+		io-channels = <&saradc 1>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1800000>;
+		poll-interval = <100>;
+
+		/* vendor rockchip,adc_value (10-bit, Vref 1.8 V): 510 / 680 / 865 */
+		button-vol-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			press-threshold-microvolt = <896000>;
+		};
+
+		button-vol-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			press-threshold-microvolt = <1195000>;
+		};
+
+		button-home {
+			label = "Home";
+			linux,code = <KEY_HOME>;
+			press-threshold-microvolt = <1520000>;
+		};
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		/* vendor brightness-levels run 255 -> 0: the PWM output is active low */
+		pwms = <&pwm0 0 10000 PWM_POLARITY_INVERTED>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <200>;
+		enable-gpios = <&gpio7 RK_PB1 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bl_en>;
+	};
+
+	ext_gmac: external-gmac-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <125000000>;
+		clock-output-names = "ext_gmac";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		key-power {
+			wakeup-source;
+			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&pwr_key>;
+		};
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&hym8563>;
+		clock-names = "ext_clock";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		reset-gpios = <&gpio4 RK_PD4 GPIO_ACTIVE_LOW>;
+	};
+
+	vcc_sys: regulator-vsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_sys";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	vcc_phy: regulator-vcc-phy {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_phy";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc_io>;
+	};
+
+	vcc_lcd: regulator-vcc-lcd {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_lcd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpio = <&gpio7 RK_PA3 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_en>;
+		regulator-boot-on;
+		vin-supply = <&vcc_io>;
+	};
+
+	vcc_sd: regulator-sdmmc {
+		compatible = "regulator-fixed";
+		gpio = <&gpio7 RK_PB3 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&sdmmc_pwr>;
+		regulator-name = "vcc_sd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <100000>;
+		vin-supply = <&vcc_io>;
+	};
+
+	vcc_otg_5v: regulator-usb-otg {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&otg_vbus_drv>;
+		regulator-name = "vcc_otg_5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+		vin-supply = <&vcc_sys>;
+	};
+};
+
+/* secondary cores come up through the Trust OS (PSCI), not by poking PMU/SRAM */
+&{/cpus} {
+	/delete-property/ enable-method;
+};
+
+&cpu0 {
+	cpu0-supply = <&vdd_cpu>;
+	enable-method = "psci";
+};
+
+&cpu1 {
+	enable-method = "psci";
+};
+
+&cpu2 {
+	enable-method = "psci";
+};
+
+&cpu3 {
+	enable-method = "psci";
+};
+
+/* the firmware has configured CNTFRQ etc.; use the non-secure timer */
+&{/timer} {
+	/delete-property/ arm,cpu-registers-not-fw-configured;
+};
+
+/*
+ * dmac_bus_s (0xffb20000) is the secure instance of the bus DMAC; reading its
+ * PrimeCell ID from the non-secure world aborts. The vendor DT never maps it.
+ */
+&dmac_bus_s {
+	status = "disabled";
+};
+
+/* timer@ff810000 sits in the secure timer block: non-secure access aborts */
+&timer {
+	status = "disabled";
+};
+
+&emmc {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	disable-wp;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_clk>, <&emmc_cmd>, <&emmc_pwr>, <&emmc_bus8>;
+	vmmc-supply = <&vcc_io>;
+	vqmmc-supply = <&vcc_18>;
+	status = "okay";
+};
+
+&gmac {
+	assigned-clocks = <&cru SCLK_MAC>;
+	assigned-clock-parents = <&ext_gmac>;
+	clock_in_out = "input";
+	pinctrl-names = "default";
+	pinctrl-0 = <&rgmii_pins>;
+	phy-supply = <&vcc_phy>;
+	phy-mode = "rgmii";
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 10000 50000>;
+	snps,reset-gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>;
+	tx_delay = <0x30>;
+	rx_delay = <0x10>;
+	status = "okay";
+};
+
+&gpu {
+	/* vendor Mali simple power model: dynamic-coefficient 733 pW/(Hz V^2) = EM units */
+	dynamic-power-coefficient = <733>;
+	mali-supply = <&vdd_gpu>;
+	status = "okay";
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	vdd_cpu: regulator@40 {
+		compatible = "silergy,syr827";
+		fcs,suspend-voltage-selector = <1>;
+		reg = <0x40>;
+		regulator-name = "vdd_cpu";
+		regulator-min-microvolt = <850000>;
+		regulator-max-microvolt = <1400000>;
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-enable-ramp-delay = <300>;
+		regulator-ramp-delay = <8000>;
+		vin-supply = <&vcc_sys>;
+	};
+
+	vdd_gpu: regulator@41 {
+		compatible = "silergy,syr828";
+		fcs,suspend-voltage-selector = <1>;
+		reg = <0x41>;
+		regulator-name = "vdd_gpu";
+		regulator-min-microvolt = <850000>;
+		regulator-max-microvolt = <1350000>;
+		regulator-always-on;
+		vin-supply = <&vcc_sys>;
+	};
+
+	hym8563: rtc@51 {
+		compatible = "haoyu,hym8563";
+		reg = <0x51>;
+		#clock-cells = <0>;
+		clock-output-names = "xin32k";
+	};
+
+	/*
+	 * No pinctrl here: Firefly drives GPIO0_A1 as a PMIC power-hold GPIO, but on this
+	 * board the vendor DT muxes GPIO0_A0..A3 to their DDR power/retention functions.
+	 */
+	act8846: pmic@5a {
+		compatible = "active-semi,act8846";
+		reg = <0x5a>;
+		system-power-controller;
+
+		vp1-supply = <&vcc_sys>;
+		vp2-supply = <&vcc_sys>;
+		vp3-supply = <&vcc_sys>;
+		vp4-supply = <&vcc_sys>;
+		inl1-supply = <&vcc_sys>;
+		inl2-supply = <&vcc_sys>;
+		inl3-supply = <&vcc_20>;
+
+		regulators {
+			vcc_ddr: REG1 {
+				regulator-name = "vcc_ddr";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-always-on;
+			};
+
+			vcc_io: REG2 {
+				regulator-name = "vcc_io";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			vdd_log: REG3 {
+				regulator-name = "vdd_log";
+				regulator-min-microvolt = <1150000>;
+				regulator-max-microvolt = <1150000>;
+				regulator-always-on;
+			};
+
+			vcc_20: REG4 {
+				regulator-name = "vcc_20";
+				regulator-min-microvolt = <2000000>;
+				regulator-max-microvolt = <2000000>;
+				regulator-always-on;
+			};
+
+			vccio_sd: REG5 {
+				regulator-name = "vccio_sd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			vdd10_lcd: REG6 {
+				regulator-name = "vdd10_lcd";
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <1000000>;
+				regulator-always-on;
+			};
+
+			vcca_codec: REG7 {
+				regulator-name = "vcca_codec";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			vcca_tp: REG8 {
+				regulator-name = "vcca_tp";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			vccio_pmu: REG9 {
+				regulator-name = "vccio_pmu";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				regulator-always-on;
+			};
+
+			vdd_10: REG10 {
+				regulator-name = "vdd_10";
+				regulator-min-microvolt = <1000000>;
+				regulator-max-microvolt = <1000000>;
+				regulator-always-on;
+			};
+
+			vcc_18: REG11 {
+				regulator-name = "vcc_18";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+
+			vcc18_lcd: REG12 {
+				regulator-name = "vcc18_lcd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+		};
+	};
+};
+
+/* touchscreen (goodix @0x5d) lives here; added once the display works */
+/* sensors: vendor lists BMA2xx @0x18 and MiR3DA @0x27; only 0x18 answers. Chip ID 0x03 and constant
+ * LSB bits 7:6 => BMA222 (8-bit). Vendor polls it (irq_enable = 0), so no interrupt here. */
+&i2c1 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	accelerometer@18 {
+		compatible = "bosch,bma222";
+		reg = <0x18>;
+	};
+};
+
+/* eFuse is secure-only under the vendor Trust OS (vendor uses "rockchip,rk3288-secure-efuse" via
+ * SMC); a direct read hangs. Its driver is a module, so it would bind as soon as modules exist. */
+&efuse {
+	status = "disabled";
+};
+
+/* audio: ES8316 codec @0x10; NFC BCM2079x @0x76 */
+&i2c2 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	es8316: audio-codec@10 {
+		compatible = "everest,es8316";
+		reg = <0x10>;
+		clocks = <&cru SCLK_I2S0_OUT>;
+		clock-names = "mclk";
+		/* MCLK pin GPIO6_B0 is part of mainline's i2s0_bus group (claimed by &i2s) */
+		#sound-dai-cells = <0>;
+	};
+};
+
+/*
+ * The bus DMAC is one PL330 with two windows: 0xffb20000 (secure, disabled above) and 0xff600000
+ * (non-secure, same request lines). The vendor DT points its "bus DMAC" node at 0xff600000.
+ */
+&dmac_bus_ns {
+	status = "okay";
+};
+
+&i2s {
+	dmas = <&dmac_bus_ns 0>, <&dmac_bus_ns 1>;
+	dma-names = "tx", "rx";
+	rockchip,playback-channels = <8>;
+	rockchip,capture-channels = <2>;
+	#sound-dai-cells = <0>;
+	status = "okay";
+};
+
+/* touchscreen: Goodix GT9271 (product ID "9271", fw 0x1040). Answers at 0x14 here (vendor DT says
+ * 0x5d; the address is latched from INT at reset and the driver selects it from `reg`).
+ * Its config RAM is empty after reset: the driver uploads /lib/firmware/goodix_9271_cfg.bin
+ * (186 B, extracted from the vendor kernel, hardware/firmware/). Config is 1280x800 landscape. */
+&i2c4 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@14 {
+		compatible = "goodix,gt9271";
+		reg = <0x14>;
+		interrupt-parent = <&gpio7>;
+		interrupts = <RK_PA6 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&gpio7 RK_PA6 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio7 RK_PA5 GPIO_ACTIVE_HIGH>;
+		AVDD28-supply = <&vcca_tp>;
+		/* measured 2026-11-07: raw X runs bottom->top, raw Y left->right of the
+		 * native portrait panel (800x1280) -> invert X, then swap */
+		touchscreen-inverted-x;
+		touchscreen-swapped-x-y;
+	};
+};
+
+/* vendor io-domains only override these two; the rest stay at their reset defaults */
+&io_domains {
+	sdcard-supply = <&vccio_sd>;
+	wifi-supply = <&vcc_18>;
+	status = "okay";
+};
+
+&mipi_dsi {
+	/* vendor rockchip,lane-rate = 800; auto (~500 Mbps) makes the image jitter */
+	rockchip,lane-rate-mbps = <800>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "smarttab,jd9365da-800x1280";
+		reg = <0>;
+		backlight = <&backlight>;
+		reset-gpios = <&gpio7 RK_PA2 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vcc_lcd>;
+		vccio-supply = <&vcc_lcd>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&lcd_rst>;
+
+		port {
+			panel_in_dsi: endpoint {
+				remote-endpoint = <&dsi_out_panel>;
+			};
+		};
+	};
+};
+
+&mipi_out {
+	dsi_out_panel: endpoint {
+		remote-endpoint = <&panel_in_dsi>;
+	};
+};
+
+/* the vendor routes only VOP-big into DSI0; VOP-little (vopl) stays disabled */
+
+&pwm0 {
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcc_18>;
+	status = "okay";
+};
+
+&sdio0 {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	keep-power-in-suspend;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdio0_bus4>, <&sdio0_cmd>, <&sdio0_clk>;
+	vmmc-supply = <&vcc_io>;
+	vqmmc-supply = <&vcc_18>;
+	status = "okay";
+};
+
+&sdmmc {
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	card-detect-delay = <200>;
+	disable-wp;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc_clk>, <&sdmmc_cmd>, <&sdmmc_cd>, <&sdmmc_bus4>;
+	vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	status = "okay";
+};
+
+&tsadc {
+	/* perf session 2026-11-07: user provides active cooling; default hw reset is 95 C */
+	rockchip,hw-tshut-temp = <100000>;
+	rockchip,hw-tshut-mode = <0>;
+	rockchip,hw-tshut-polarity = <0>;
+	status = "okay";
+};
+
+/* debug console; only TX reaches the header (pad TX2) */
+&uart2 {
+	status = "okay";
+};
+
+/*
+ * UART4: enabled in the vendor DT with no other user (GPIO5_B7 rx / B6 tx).
+ * Most likely the USB-A socket labelled "serial" (external camera control link,
+ * no VBUS, no USB data). Unverified until the camera is connected.
+ */
+&uart4 {
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
+
+/* EHCI: on-board GL850G hub (05e3:0610) -> USB-A port + camera */
+&usb_host0_ehci {
+	status = "okay";
+};
+
+/* DWC2 host: the port the USB keyboard sits on */
+&usb_host1 {
+	status = "okay";
+};
+
+/* OTG = the micro-USB port (rkdeveloptool/maskrom side) */
+&usb_otg {
+	dr_mode = "otg";
+	status = "okay";
+};
+
+&vopb {
+	/* NOTE: do NOT reparent dclk_vop0 to NPLL / set NPLL 408 MHz: NPLL never locks under
+	 * the vendor Trust OS -> endless relock retries -> kernel stack overflow at boot. */
+	status = "okay";
+};
+
+&vopb_mmu {
+	status = "okay";
+};
+
+&wdt {
+	status = "okay";
+};
+
+/*
+ * Bluetooth: AP6212 (BCM43438A1) on UART0 with RTS/CTS. Vendor "wireless-bluetooth":
+ * BT,reset_gpio = GPIO4_D5 (BT_REG_ON), BT,wake_gpio = GPIO4_D2, BT,wake_host_irq = GPIO4_D7.
+ * LPO = 32 kHz from the hym8563 (shared with the SDIO WiFi pwrseq).
+ */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_xfer &uart0_cts &uart0_rts>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm43438-bt";
+		clocks = <&hym8563>;
+		clock-names = "lpo";
+		max-speed = <1500000>;
+		shutdown-gpios = <&gpio4 RK_PD5 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpio4 RK_PD2 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&gpio4 RK_PD7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_reg_on &bt_wake &bt_host_wake>;
+	};
+};
+
+&pinctrl {
+	lcd {
+		lcd_en: lcd-en {
+			rockchip,pins = <7 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		lcd_rst: lcd-rst {
+			rockchip,pins = <7 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		bl_en: bl-en {
+			rockchip,pins = <7 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	keys {
+		pwr_key: pwr-key {
+			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	sdmmc {
+		sdmmc_pwr: sdmmc-pwr {
+			rockchip,pins = <7 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	sdio-pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			rockchip,pins = <4 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	bluetooth {
+		bt_reg_on: bt-reg-on {
+			rockchip,pins = <4 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		bt_wake: bt-wake {
+			rockchip,pins = <4 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		bt_host_wake: bt-host-wake {
+			rockchip,pins = <4 RK_PD7 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
+	audio {
+		spk_en: spk-en {
+			rockchip,pins = <7 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb_otg {
+		otg_vbus_drv: otg-vbus-drv {
+			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
+
+/*
+ * Performance tuning (2026-11-07). Overclock OPPs as used by mainline
+ * rk3288-tinker / rk3288-veyron. Thermal trips raised: user provides cooling.
+ * Revert: extras/perf/rk3288-smarttab.dts.pre-perf
+ */
+&cpu_opp_table {
+	/*
+	 * Per-chip undervolt (2026-11-08): lowest voltage passing 30 s of
+	 * stress-ng --cpu-method all --verify at ~55-72 C, plus 50 mV margin.
+	 * Search log: extras/perf/uv-log.txt (script extras/perf/uv-search.sh).
+	 * 1704/1800 are overclock OPPs (as mainline tinker/veyron, which use
+	 * 1350/1400 mV). Spec voltages: extras/perf/rk3288-smarttab.dts.pre-uv.
+	 */
+	opp-696000000 {
+		opp-hz = /bits/ 64 <696000000>;
+		opp-microvolt = <900000>;
+	};
+	opp-816000000 {
+		opp-hz = /bits/ 64 <816000000>;
+		opp-microvolt = <925000>;
+	};
+	opp-1008000000 {
+		opp-hz = /bits/ 64 <1008000000>;
+		opp-microvolt = <975000>;
+	};
+	opp-1200000000 {
+		opp-hz = /bits/ 64 <1200000000>;
+		opp-microvolt = <1050000>;
+	};
+	opp-1416000000 {
+		opp-hz = /bits/ 64 <1416000000>;
+		opp-microvolt = <1125000>;
+	};
+	opp-1512000000 {
+		opp-hz = /bits/ 64 <1512000000>;
+		opp-microvolt = <1175000>;
+	};
+	opp-1608000000 {
+		opp-hz = /bits/ 64 <1608000000>;
+		opp-microvolt = <1225000>;
+	};
+	opp-1704000000 {
+		opp-hz = /bits/ 64 <1704000000>;
+		opp-microvolt = <1275000>;
+	};
+	opp-1800000000 {
+		opp-hz = /bits/ 64 <1800000000>;
+		opp-microvolt = <1325000>;
+	};
+};
+
+/*
+ * Thermal: one power_allocator (IPA) zone budgets CPU + GPU together.
+ * Heatsink is space-limited (user design, at its limit): measured CPU+GPU
+ * equilibrium ~3.4 W at 85-90 C -> sustainable-power 3500 mW.
+ * IPA switches on at cpu_alert0 (80 C) and regulates to cpu_alert1 (87 C).
+ * Runtime A/B: echo step_wise > /sys/class/thermal/thermal_zone0/policy
+ */
+&cpu_thermal {
+	sustainable-power = <3500>;
+
+	cooling-maps {
+		map0 {
+			trip = <&cpu_alert0>;
+			cooling-device =
+				<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+		map1 {
+			trip = <&cpu_alert1>;
+			cooling-device =
+				<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+				<&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+		};
+	};
+};
+
+&cpu_alert0 {
+	temperature = <80000>;
+};
+
+&cpu_alert1 {
+	temperature = <87000>;
+};
+
+&cpu_crit {
+	temperature = <95000>;
+};
+
+/* GPU zone: only the critical trip; throttling is done by the CPU zone's IPA */
+&gpu_thermal {
+	/delete-node/ cooling-maps;
+
+	trips {
+		/delete-node/ gpu_alert0;
+	};
+};
+
+&gpu_crit {
+	temperature = <95000>;
+};
