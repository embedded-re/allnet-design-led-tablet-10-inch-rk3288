+static void addDoomKeyToQueue(int pressed, unsigned char key){
+  s_KeyQueue[s_KeyQueueWriteIndex] = (pressed << 8) | key;
+  s_KeyQueueWriteIndex++;
+  s_KeyQueueWriteIndex %= KEYQUEUE_SIZE;
+}
+
+/* smarttab: mouse look — x motion turns, left = fire, middle = forward, right = use */
+static int s_MouseButtons = 0;
+
 static void handleKeyInput(){
   SDL_Event e;
+  int mouse_dx = 0, mouse_changed = 0;
   while (SDL_PollEvent(&e)){
+    if (e.type == SDL_MOUSEMOTION) {
+      mouse_dx += e.motion.xrel;
+      mouse_changed = 1;
+      continue;
+    }
+    if (e.type == SDL_MOUSEBUTTONDOWN || e.type == SDL_MOUSEBUTTONUP) {
+      int down = (e.type == SDL_MOUSEBUTTONDOWN);
+      if (e.button.button == SDL_BUTTON_RIGHT) {
+        addDoomKeyToQueue(down, KEY_USE);
+      } else {
+        int bit = (e.button.button == SDL_BUTTON_LEFT) ? 1 :
+                  (e.button.button == SDL_BUTTON_MIDDLE) ? 4 : 0;
+        if (down) s_MouseButtons |= bit; else s_MouseButtons &= ~bit;
+        mouse_changed = 1;
+      }
+      continue;
+    }
     if (e.type == SDL_QUIT){
       puts("Quit requested");
       atexit(SDL_Quit);
@@ -128,6 +171,15 @@ static void handleKeyInput(){
       addKeyToQueue(0, e.key.keysym.sym);
     }
   }
+  if (mouse_changed) {
+    event_t ev;
+    ev.type = ev_mouse;
+    ev.data1 = s_MouseButtons;
+    ev.data2 = mouse_dx * 4;   /* turn speed; menu "mouse sensitivity" scales further */
+    ev.data3 = 0;              /* no forward/back from vertical mouse motion */
+    ev.data4 = 0;
+    D_PostEvent(&ev);
+  }
 }
 
 
